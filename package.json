{
  "name": "khaled-hasan-portfolio",
  "version": "2.0.0",
  "description": "Static academic portfolio with centralized content, writing, and photo stories for GitHub Pages.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "python3 scripts/check.py",
    "test": "node --test scripts/build.test.mjs",
    "dev": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "start": "node scripts/preview.mjs",
    "legacy:start": "node server/index.js",
    "legacy:dev": "node --watch server/index.js",
    "legacy:seed": "node server/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "academic",
    "portfolio",
    "static",
    "github-pages"
  ],
  "author": "Khaled Hasan",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2"
  }
}
